+@app.post("/kernel/execute", response_model=KernelExecuteResponse)
+async def execute_kernel(request: KernelExecuteRequest):
+    """执行 Python 代码"""
+    global kernel_instance
+    if not kernel_instance:
+        raise HTTPException(status_code=503, detail="Kernel not initialized")
+
+    try:
+        logger.info("收到 kernel 执行请求")
+        async with kernel_execution_lock:
+            if request.restart:
+                reset_result = await asyncio.to_thread(kernel_instance.reset_kernel)
+                if not reset_result.get("success"):
+                    logger.error(f"Kernel 重置失败: {reset_result.get('message')}")
+                    raise HTTPException(
+                        status_code=500,
+                        detail=reset_result.get("message", "Failed to reset kernel"),
+                    )
+
+            init_result = await asyncio.to_thread(kernel_instance.run_init_script_if_needed)
+            if init_result is not None and not init_result.success:
+                logger.error(f"Kernel 初始化脚本执行失败: {init_result.error}")
+                raise HTTPException(
+                    status_code=500,
+                    detail=init_result.error or "Kernel initialization script failed",
+                )
+
+            result = await asyncio.to_thread(
+                kernel_instance.execute,
+                request.code,
+                timeout=request.timeout,
+            )
+        return KernelExecuteResponse(
+            success=result.success,
+            output=result.output,
+            error=result.error,
+            images=result.images or [],
+        )
+    except HTTPException:
+        raise
+    except Exception as e:
+        logger.error(f"执行 kernel 代码时发生错误: {str(e)}")
+        raise HTTPException(status_code=500, detail=f"Internal server error: {str(e)}")
+
